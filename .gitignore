# Local .terraform directories
.terraform/

# Terraform state files
*.tfstate
*.tfstate.backup

# Crash logs
crash.log

# Override files (often used for local testing)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Sensitive variable files (optional, like terraform.tfvars)
#terraform.tfvars
#*.auto.tfvars
.terraform.lock.hcl
# CLI configuration files
.terraformrc
terraform.rc

# Sensitive output plans
*.tfplan

# IDE/editor specific
.vscode/
.idea/
*.swp
*~
